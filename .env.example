# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL — from Supabase dashboard → Settings → API
SUPABASE_URL=https://REPLACE_PROJECT_REF.supabase.co

# Anon (public) key — safe to expose in browser JS; RLS policies protect data
SUPABASE_ANON_KEY=REPLACE_SUPABASE_ANON_KEY

# Service role key — used by n8n for upserts; NEVER expose in browser
SUPABASE_SERVICE_KEY=REPLACE_SUPABASE_SERVICE_KEY

# ── Cloudflare ────────────────────────────────────────────────────────────────
# API token — from https://dash.cloudflare.com/profile/api-tokens
# Required permission: Cloudflare Pages — Edit
CLOUDFLARE_API_TOKEN=REPLACE_CLOUDFLARE_API_TOKEN

# Account ID — from Cloudflare dashboard right sidebar
CLOUDFLARE_ACCOUNT_ID=REPLACE_CLOUDFLARE_ACCOUNT_ID

# ── n8n ───────────────────────────────────────────────────────────────────────
# Google Drive folder ID containing CellarTracker CSV exports
GDRIVE_FOLDER_ID=REPLACE_GOOGLE_DRIVE_FOLDER_ID

# Gmail address for sync notifications
NOTIFY_EMAIL=REPLACE_YOUR_EMAIL@example.com
